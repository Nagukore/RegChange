# RegChange Sentinel -- backend environment template
#
# Copy to `backend/.env` and fill in. `.env` is gitignored and MUST NEVER be
# committed. No real key belongs in this file.
#
#   cp backend/.env.example backend/.env
#
# The app starts and the UI works without any of these; features that need a
# credential report themselves as "not configured" rather than faking results.

# ---------------------------------------------------------------------------
# TinyFish -- web intelligence (REQUIRED for regulatory discovery/extraction)
# Create a key: https://agent.tinyfish.ai/api-keys
# Search is free to 12,000 req/day and Fetch to 1,000 URLs/day, no card needed.
# ---------------------------------------------------------------------------
TINYFISH_API_KEY=

# ---------------------------------------------------------------------------
# Google Gemini -- regulatory analysis, impact mapping, test generation
# Create a key: https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# ---------------------------------------------------------------------------
# Database
# Supabase: Project Settings -> Database -> Connection string -> URI.
# Use the pooled connection (port 6543) for serverless, 5432 for long-lived.
# Leave DATABASE_URL empty to use a local SQLite file (backend/regchange.db).
# ---------------------------------------------------------------------------
DATABASE_URL=
DB_ECHO=false

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Regulatory scope
# The RBI KYC framework differs by regulated-entity type, so this is explicit
# rather than assumed. See docs/REGULATORY_SCOPE.md.
#   COMMERCIAL_BANK | SMALL_FINANCE_BANK | PAYMENTS_BANK | CO_OPERATIVE_BANK
#   | NBFC | PAYMENT_SYSTEM_PROVIDER
# ---------------------------------------------------------------------------
REGULATORY_AUTHORITY=RBI
INSTITUTION_TYPE=COMMERCIAL_BANK
REGULATORY_DOMAINS=rbi.org.in
# How far back each discovery search looks. Search ranks by relevance, not date.
DISCOVERY_LOOKBACK_DAYS=365

# ---------------------------------------------------------------------------
# Core banking simulator targets
# CBS_LOCAL_BASE_URL   -- used by local Playwright browser tests.
# CBS_PUBLIC_BASE_URL  -- TinyFish's cloud browser cannot reach localhost, so
#                         set this to a publicly reachable deployment (or an
#                         ngrok/cloudflared tunnel) to enable the TinyBrowser
#                         execution driver. Empty = driver reports unavailable.
# ---------------------------------------------------------------------------
CBS_LOCAL_BASE_URL=http://localhost:5173
CBS_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Execution safety
# Leave this true. It forces an APPROVED human decision record to exist before
# any state-changing test runs against the simulator.
# ---------------------------------------------------------------------------
REQUIRE_APPROVAL_FOR_EXECUTION=true

# ---------------------------------------------------------------------------
# Auth -- generate a strong secret for anything other than local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# BOOTSTRAP_ADMIN_PASSWORD seeds the first admin user on startup. Leave empty
# to skip seeding (no default password is ever created).
# ---------------------------------------------------------------------------
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRY_MINUTES=720
BOOTSTRAP_ADMIN_EMAIL=admin@regchange.local
BOOTSTRAP_ADMIN_PASSWORD=
